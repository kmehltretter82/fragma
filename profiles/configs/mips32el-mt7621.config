# Minimal pinned seed for the MT7621 MIPS32el profile.  olddefconfig supplies
# all remaining defaults from the pinned Linux revision.
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_32BIT=y
CONFIG_RALINK=y
CONFIG_SOC_MT7621=y
CONFIG_CPU_LITTLE_ENDIAN=y
CONFIG_CPU_MIPS32_R2=y
CONFIG_SMP=y
CONFIG_MIPS_CPS=y
CONFIG_NR_CPUS=4
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
