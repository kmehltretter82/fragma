  "scope": {
    "evidence_kind": "semantic_calibration",
    "accepted_capabilities": [
      "The exact herd7 7.58 executable can run the exact pinned Linux Kernel Memory Model with an explicit authenticated generic CAT library.",
      "The model distinguishes two canonical unordered outcomes from their release/acquire and full-barrier counterparts.",
      "The selected READ_ONCE, WRITE_ONCE, smp_store_release, smp_load_acquire and smp_mb spellings are consumed as Linux litmus-test primitives."
    ],
    "exclusions": [
      "These four kernel-owned litmus tests are semantic calibrations, not production kernel functions or discovered defects.",
      "No production source-to-litmus correspondence, object lifetime, lock-free functional property or progress guarantee is established.",
      "No compiler lowering or architecture-specific implementation is checked by this architecture-independent LKMM run.",
      "A Never outcome is conditional on the exact litmus test, model and provider identities; it is not a whole-kernel proof.",
      "No klitmus7 module generation, running-kernel execution, package installation or privileged action is included."
    ]
  },
