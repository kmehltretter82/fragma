      "producer_payload": {
        "file": "build/sources/linux-b9b3e33b70b71/kernel/trace/trace_sched_switch.c",
        "function": "trace_alloc_tgid_map",
        "source_snippet": "tgid_map_max = init_pid_ns.pid_max;",
        "model_snippet": "*tgid_map_max = 1;",
        "argument": "Both objects have static zero initialization. PID_MAX_DEFAULT is positive; the model value 1 distinguishes the assigned maximum from its old zero value without depending on its magnitude."
      },
      "producer_publish": {
        "file": "build/sources/linux-b9b3e33b70b71/kernel/trace/trace_sched_switch.c",
        "function": "trace_alloc_tgid_map",
        "source_snippet": "smp_store_release(&tgid_map, map);",
        "model_snippet": "smp_store_release(tgid_map, 1);",
        "argument": "The condition selects only a successful allocation and abstracts its non-NULL pointer as 1."
      },
      "consumer_observe": {
        "file": "build/sources/linux-b9b3e33b70b71/kernel/trace/trace_sched_switch.c",
        "function": "trace_find_tgid_ptr",
        "source_snippet": "int *map = smp_load_acquire(&tgid_map);",
        "model_snippet": "r0 = smp_load_acquire(tgid_map);",
        "argument": "The model observes the same publication variable and represents NULL/non-NULL by 0/1."
      },
      "consumer_payload": {
        "file": "build/sources/linux-b9b3e33b70b71/kernel/trace/trace_sched_switch.c",
        "function": "trace_find_tgid_ptr",
        "source_snippet": "if (unlikely(!map || pid > tgid_map_max))",
        "model_snippet": "if (r0)\n\t\tr1 = *tgid_map_max;",
        "argument": "C short-circuiting reads tgid_map_max only when map is non-NULL. The model preserves that guard and asks only whether this read can see old zero."
      }
    },
