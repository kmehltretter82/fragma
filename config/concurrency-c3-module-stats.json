  "property": {
    "kind": "kernel_atomic_rmw_no_lost_update",
    "claim": "On the configured SMP x86-64 profile, starting from zero and in the absence of any other update, two completed concurrent executions of the failed_load_modules atomic_inc() contribute exactly two; the final value one is impossible.",
    "source_file": "build/sources/linux-b9b3e33b70b71/kernel/module/stats.c",
    "source_function": "mod_stat_bump_invalid",
    "caller_file": "build/sources/linux-b9b3e33b70b71/kernel/module/main.c",
    "caller_function": "load_module",
    "counter": "failed_load_modules",
    "source_update": "atomic_inc(&failed_load_modules);",
    "model_update": "atomic_inc(counter);",
    "concurrency_argument": "The pinned source documents module-load races and exposes init_module/finit_module entry points; mod_stat_bump_invalid() is reached after per-list module_mutex critical sections, and failed_load_modules is a kernel-wide incremental statistic.",
    "lifetime_argument": "failed_load_modules is a translation-unit-local static atomic_t with zero initialization and no reset, decrement, alternative write, or deallocation in the pinned translation unit.",
    "implementation_argument": "The kernel atomic_t contract makes RMW operations SMP atomic; the pinned LKMM model treats atomic_inc as one RMW, and the configured x86-64 object lowers the selected increment to lock incl against the counter's local .bss location.",
    "exclusions": [
      "The claim assumes initial value zero, exactly two selected increments, and no concurrent third update; it is a no-lost-update property, not a claim about an arbitrary debugfs snapshot.",
      "The model omits invalid_mod_bytes, allocation, error-path functionality, module lifetime, and whole module-loader behavior.",
      "The no-return atomic_inc operation is relaxed with respect to other locations; no cross-object ordering is claimed.",
      "Counter wraparound is defined by the kernel contract but excluded from this two-increment zero-origin property.",
      "No architecture implementation other than the configured SMP x86-64 profile is accepted by this source-linked pilot.",
      "No progress, fairness, lock-freedom, wait-freedom, runtime reachability frequency, or whole-kernel race-freedom property is claimed."
    ]
  },
  "model": {
    "atomicity_condition": "exists ([counter]=1)",
    "ordering_condition": "exists (0:r0=0 /\\ 1:r0=0)",
    "abstraction": {
      "counter": "The static zero-initialized failed_load_modules atomic_t is represented by counter, initially zero.",
