  "property": {
    "kind": "kernel_refcount_final_put_vs_get_unless_zero",
    "claim": "For a locking-stabilized System V IPC object whose refcount starts at one, one selected ipc_rcu_putref() and one concurrent selected ipc_rcu_getref() cannot both schedule last-reference RCU destruction and return a successful reference acquisition.",
    "source_file": "build/sources/linux-b9b3e33b70b71/ipc/util.c",
    "contract_file": "build/sources/linux-b9b3e33b70b71/ipc/util.h",
    "refcount_file": "build/sources/linux-b9b3e33b70b71/include/linux/refcount.h",
    "get_function": "ipc_rcu_getref",
    "put_function": "ipc_rcu_putref",
    "get_source": "return refcount_inc_not_zero(&ptr->refcount);",
    "put_test_source": "if (!refcount_dec_and_test(&ptr->refcount))",
    "put_destroy_source": "call_rcu(&ptr->rcu, func);",
    "initial_refcount": 1,
    "stability_argument": "The pinned IPC contract requires caller locking; the property assumes that prerequisite keeps ptr and its refcount storage valid for both selected operations.",
    "lifetime_argument": "The final decrement schedules RCU destruction only when refcount_dec_and_test() observes the 1-to-0 transition; refcount_inc_not_zero() cannot acquire a reference from zero.",
    "model_argument": "With initial value one and exactly one competing get, the refcount get loop can succeed only in its first compare/exchange from 1 to 2; a failed compare means the sole decrement already installed zero, so the single relaxed cmpxchg is behaviorally exact for this outcome.",
    "implementation_argument": "The pinned LKMM treats the selected updates as indivisible RMWs, and the configured x86-64 object lowers the get to lock cmpxchg and the put to lock xadd before its call_rcu branch.",
    "exclusions": [
      "The caller-locking and pointer-stability prerequisite is assumed, not proved; an attempt through already reclaimed storage is outside the property.",
      "The initial refcount is exactly one, there is one selected get and one selected put, and no third refcount update is modeled.",
      "RCU grace periods, callback execution, allocator reuse, ABA and SLAB_TYPESAFE_BY_RCU behavior are not modeled; call_rcu is represented only by the successful final-put decision.",
      "Saturation, overflow, underflow, warning paths and values outside zero, one and two are excluded.",
      "The acquire-after-control-dependency orders later destruction work but cannot change the selected same-refcount mutual-success outcome, so cross-object ordering is not claimed.",
      "The unsafe resurrection case is a detecting control and is permanently ineligible as verification evidence.",
      "No architecture implementation other than the configured SMP x86-64 profile is accepted by this source-linked pilot.",
      "No progress, fairness, retry bound, lock-freedom, wait-freedom, whole-IPC correctness, whole-RCU correctness or whole-kernel race-freedom property is claimed."
    ]
  },
  "model": {
    "condition": "exists (0:released=1 /\\ 1:acquired=1)",
    "abstraction": {
      "refcount": "ptr->refcount is represented by refs and initialized to the IPC contract's value one.",
      "put": "ipc_rcu_putref's successful refcount_dec_and_test and ensuing call_rcu scheduling decision are represented by released=1 after an old value of one.",
      "get": "ipc_rcu_getref's successful bounded inc-not-zero loop is represented by acquired=1 after a relaxed 1-to-2 compare/exchange.",
      "control": "The unsafe control replaces the conditional get with an unconditional relaxed atomic increment and records acquisition when it resurrects zero.",
      "omitted": "The IPC payload, locks, RCU callback body, grace period, warning branches and all unrelated refcount traffic are outside the selected functional question."
    },
