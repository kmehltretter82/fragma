C Fragma-trace-tgid-once-once

(*
 * Required weakened control for the trace tgid-map publication model.
 * It preserves the accesses and condition while removing release/acquire.
 *)

{}

P0(int *tgid_map, int *tgid_map_max) // trace_alloc_tgid_map
{
	*tgid_map_max = 1;
	WRITE_ONCE(*tgid_map, 1);
}

P1(int *tgid_map, int *tgid_map_max) // trace_find_tgid_ptr
{
	int r0;
	int r1;

	r0 = READ_ONCE(*tgid_map);
	if (r0)
		r1 = *tgid_map_max;
}

exists (1:r0=1 /\ 1:r1=0) (* Published map with stale maximum. *)
