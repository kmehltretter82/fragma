+let validate_alignment_attribute_policy mach =
+  match mach.alignment_attribute_policy with
+  | "legacy" -> Ok ()
+  | "clang-21-u32-bits" ->
+    if mach.compiler <> "clang" then
+      Error (`Msg "alignment_attribute_policy=clang-21-u32-bits requires compiler=clang")
+    else if not Z.(equal (of_int mach.max_extended_alignment) (shift_left one 32)) then
+      Error (`Msg "alignment_attribute_policy=clang-21-u32-bits requires max_extended_alignment=4294967296 bytes")
+    else Ok ()
+  | policy ->
+    Error (`Msg (Format.asprintf "unknown alignment_attribute_policy: %S" policy))
+
+(* Keep the generated decoder's defaults and type checks, then validate the
+   explicit policy before a parsed machdep can be used for preprocessing. *)
+let mach_of_yaml yaml =
+  let repeated_policy =
+    match yaml with
+    | `O fields ->
+      List.length
+        (List.filter (fun (name, _) -> name = "alignment_attribute_policy") fields) > 1
+    | _ -> false
+  in
+  if repeated_policy then
+    Error (`Msg "duplicate alignment_attribute_policy")
+  else
+    Result.bind (mach_of_yaml yaml)
+      (fun mach ->
+         Result.map (fun () -> mach) (validate_alignment_attribute_policy mach))
 
