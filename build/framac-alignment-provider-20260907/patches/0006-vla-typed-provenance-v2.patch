 (* Maps local variables that are variable sized arrays to the expression that
  * denotes their length *)
 let varSizeArrays : exp IH.t = IH.create 17
+
+(* Private typing provenance, never an emitted second object. The original
+   varinfo retains its typed array, frozen bound, location and original
+   declaration alignment. The key is the final lowered variable's vid. *)
+let varSizeArrayOrigins : varinfo IH.t = IH.create 17
+
+let var_size_array_origin source e =
+  if not (Machine.clang_u32_alignment_policy ()) then None
+  else match (stripParen source).expr_node, e.enode with
+    (* Do not recover an array from a comma/cast/conditional which C already
+       decayed, even when normalization leaves the same pointer Lval. *)
+    | Cabs.VARIABLE _, Lval (Var vi, NoOffset) ->
+      IH.find_opt varSizeArrayOrigins vi.vid
+    | _ -> None
+
+let source_has_comma_decay source =
+  match (stripParen source).expr_node with
+  | Cabs.COMMA (_ :: _ :: _) -> true
+  | _ -> false
+
+let mentions_var_size_array e =
+  let found = ref false in
+  let visitor = object
+    inherit Cil.nopCilVisitor
+    method! vvrbl vi =
+      if IH.mem varSizeArrayOrigins vi.vid then found := true;
+      SkipChildren
+  end in
+  ignore (Cil.visitCilExpr visitor e);
+  !found
+
+(* Unlike Cil.is_variably_modified_type, also inspect pointer targets. Such
+   locals require a different lowering; do not accidentally accept them as
+   ordinary pointers after evaluating a dynamic declarator bound. *)
+let rec has_variable_array_type t =
+  match Ast_types.unroll_node t with
+  | TArray (element, length) ->
+    Option.fold ~none:false ~some:(fun e -> not (Cil.isConstant e)) length ||
+    has_variable_array_type element
+  | TPtr t -> has_variable_array_type t
+  | TFun (result, args, _) ->
+    has_variable_array_type result ||
+    Option.fold ~none:false ~some:
+      (List.exists (fun (_, t, _) -> has_variable_array_type t)) args
+  | _ -> false
 
