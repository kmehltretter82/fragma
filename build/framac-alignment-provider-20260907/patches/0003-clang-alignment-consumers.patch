+(* Interpret a validated byte request without overwriting its source form.
+   The private policy models Clang's unsigned 32-bit bit-alignment cache.
+   A zero cache contributes no constraint, not a zero object alignment. *)
+let effectiveAlignment ~c11 requested =
+  if Z.is_zero requested && c11 then None
+  else begin
+    if Z.sign requested <= 0 ||
+       not (Z.is_zero (Z.logand requested (Z.pred requested))) then
+      Kernel.abort ~current:true
+        "%s alignment must be a positive power of two"
+        (if c11 then "C11" else "GNU");
+    if Z.gt requested (Z.shift_left Z.one 32) then
+      Kernel.abort ~current:true "requested alignment exceeds 2^32 bytes";
+    let effective =
+      if Machine.clang_u32_alignment_policy () then
+        Z.shift_right (Z.extract (Z.shift_left requested 3) 0 32) 3
+      else requested
+    in
+    if Z.is_zero effective then None
+    else match Z.to_int_opt effective with
+      | Some n -> Some n
+      | None -> Kernel.abort ~current:true "alignment exceeds host integer range"
+  end
